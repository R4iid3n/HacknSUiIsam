# ============================================
# LémanFlow Environment Configuration
# ============================================

# ----------------
# Server Config
# ----------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ----------------
# Sui Network
# ----------------
# Options: mainnet, testnet, devnet, localnet
SUI_NETWORK=testnet

# RPC URL (optional, defaults based on network)
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# ----------------
# Smart Contracts
# ----------------
# Package ID after deploying Move contracts
# Get this by running: sui client publish --gas-budget 100000000
PACKAGE_ID=0x0

# ----------------
# Sponsor Account (CRITICAL for gasless transactions)
# ----------------
# This account pays for all user transactions
# Generate with: sui keytool generate ed25519
# Fund with: sui client faucet (testnet) or transfer SUI (mainnet)

# Format: hex string (without 0x prefix)
SPONSOR_PRIVATE_KEY=

# Sponsor wallet address (for reference)
SPONSOR_ADDRESS=

# ----------------
# Security
# ----------------
# Secret for signing QR codes (change in production!)
QR_SECRET=change-me-in-production-use-strong-random-string

# Session cookie secret (change in production!)
SESSION_SECRET=change-me-in-production-use-strong-random-string

# Session max age in milliseconds (default: 24h)
SESSION_MAX_AGE=86400000

# ----------------
# zkLogin OAuth (optional)
# ----------------
# Google OAuth
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=

# GitHub OAuth
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------
# Development
# ----------------
# Set to 'true' to run without blockchain (for development)
# Auto-enabled if SPONSOR_PRIVATE_KEY is not set
MOCK_MODE=false

# Node environment
NODE_ENV=development

# ============================================
# Quick Start Guide
# ============================================
#
# 1. Deploy Move contracts:
#    cd move
#    sui client publish --gas-budget 100000000
#    -> Copy PACKAGE_ID from output
#
# 2. Create sponsor account:
#    sui keytool generate ed25519
#    -> Copy private key and address
#
# 3. Fund sponsor account:
#    Testnet: sui client faucet
#    Mainnet: Transfer SUI to sponsor address
#
# 4. Update this file with values
#
# 5. Install dependencies:
#    cd backend
#    npm install
#
# 6. Start backend:
#    npm run dev
#
# 7. Start frontend:
#    cd ../frontend
#    npm run dev
#
# ============================================
# Production Checklist
# ============================================
#
# ✅ Change QR_SECRET to strong random string
# ✅ Change SESSION_SECRET to strong random string
# ✅ Set MOCK_MODE=false
# ✅ Use mainnet or testnet (not devnet/localnet)
# ✅ Ensure sponsor account has sufficient SUI balance
# ✅ Set CORS_ORIGIN to your frontend domain
# ✅ Configure OAuth credentials for zkLogin
# ✅ Enable HTTPS (use reverse proxy like nginx)
# ✅ Set NODE_ENV=production
#

# ============================================
# SUI Features Integration
# ============================================

# ----------------
# Enoki - Managed zkLogin
# ----------------
# Get API key from: https://enoki.mystenlabs.com/
ENOKI_API_KEY=
ENOKI_API_URL=https://api.enoki.mystenlabs.com

# ----------------
# SuiNS - Name Service
# ----------------
# Optional custom registry (defaults to testnet)
# SUINS_PACKAGE_ID=0x22fa05f21b1ad71442491220bb9338f7b7095fe35000ef88d5400d28523bdd93
# SUINS_REGISTRY_ID=0xe64cd9db9f829c6cc405d9790bd71567ae07259855f4fba6f02c84f52298c106

# ----------------
# Walrus - Decentralized Storage
# ----------------
# Auto-enabled when MOCK_MODE=false
# No additional configuration needed
