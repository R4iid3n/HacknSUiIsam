# LémanFlow Frontend Configuration

# ----------------
# Backend API
# ----------------
# Backend API URL (must match backend PORT)
VITE_API_BASE=http://localhost:4000

# ----------------
# Blockchain
# ----------------
# Event ID (get from backend after creating event)
VITE_EVENT_ID=0xe13b43211fca648ff5a3198b3282d15a3c9c976ed922d418231f76680755710d

# Package ID (from Move contract deployment)
VITE_PACKAGE_ID=0x...

# App Object ID (for counter example)
VITE_APP_OBJECT_ID=0x...

# ----------------
# IMPORTANT: CORS Configuration
# ----------------
# Make sure your backend .env has:
# CORS_ORIGIN=http://localhost:5173
#
# If you change frontend port in vite.config.ts,
# update CORS_ORIGIN in backend/.env to match!
